{
  "name": "riftborn",
  "private": true,
  "version": "0.1.0",
  "description": "Riftborn — 2.5D isometric ARPG",
  "author": "involvex",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "bun run server/index.ts",
    "dev:all": "concurrently -n client,server -c cyan,magenta \"bun run dev\" \"bun run server\"",
    "desktop": "bun run scripts/desktop.mjs",
    "desktop:prod": "bun run build && bunx electron . --dist",
    "icons": "bun run scripts/make-icons.mjs",
    "sprites:process": "bun run scripts/process-sprites.mjs",
    "build:portable": "bun run icons && bun run build && electron-builder --win portable",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "dev.riftborn.game",
    "productName": "Riftborn",
    "copyright": "Copyright © Riftborn",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "asar": true,
    "icon": "electron/build/icon.png",
    "win": {
      "icon": "electron/build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Riftborn-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Riftborn-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
