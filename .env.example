# Microsoft Store / AppX identity (from Partner Center → Product identity).
# Copy to .env and fill in. Never commit .env.
#
# Alternatively, paste the whole Partner Center "Product identity" page
# into .env (tab-separated Package/Identity/Name lines). build:msstore
# accepts either form.

# Package/Identity/Name
APPX_IDENTITY_NAME=

# Package/Identity/Publisher (exact CN=… string)
APPX_PUBLISHER=

# Package/Properties/PublisherDisplayName
APPX_PUBLISHER_DISPLAY_NAME=

# Reserved Store display name (defaults to Riftborn)
# APPX_DISPLAY_NAME=Riftborn

# Partner Center product / Store id for msstore publish -id …
MSSTORE_PRODUCT_ID=

# Optional alias if you only have the Store ID from Product identity
# MSSTORE_STORE_ID=
